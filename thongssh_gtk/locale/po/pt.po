msgid "Sync file is unreadable/corrupted JSON."
msgstr "O ficheiro de sincronização é ilegível/JSON corrompido."

#: thongssh_gtk/settings_sync.py:245
msgid "Sync file failed its integrity check (hash mismatch) — skipping this pass."
msgstr "O ficheiro de sincronização falhou a verificação de integridade (hash não corresponde) — a ignorar esta passagem."

#: thongssh_gtk/settings_sync.py:535
msgid "No sync folder configured."
msgstr "Nenhuma pasta de sincronização configurada."

#: thongssh_gtk/settings_sync.py:553
#, python-brace-format
msgid "Sync folder is missing ({folder}) even though this machine has synced before — it's most likely not mounted right now (e.g. a cloud-drive folder), not something deleted on purpose. Skipping this pass instead of treating that as \"everything was deleted\"."
msgstr "A pasta de sincronização está em falta ({folder}), apesar de esta máquina já ter sincronizado antes — provavelmente não está montada neste momento (por exemplo, uma pasta de um serviço na nuvem), e não foi eliminada de propósito. A ignorar esta passagem em vez de assumir que \"tudo foi eliminado\"."

#: thongssh_gtk/settings_sync.py:564
#, python-brace-format
msgid "Can't access sync folder: {error}"
msgstr "Não é possível aceder à pasta de sincronização: {error}"

#: thongssh_gtk/settings_sync.py:585
msgid "The sync folder has no sync file yet, but this machine has synced before — it's most likely not mounted/accessible right now. Skipping this pass instead of treating that as \"everything was deleted\"."
msgstr "A pasta de sincronização ainda não tem ficheiro de sincronização, mas esta máquina já sincronizou antes — provavelmente não está montada/acessível neste momento. A ignorar esta passagem em vez de assumir que \"tudo foi eliminado\"."

#: thongssh_gtk/settings_sync.py:602
msgid "This folder belongs to a different sync archive than the one this machine last used."
msgstr "Esta pasta pertence a um arquivo de sincronização diferente daquele que esta máquina usou da última vez."

#: thongssh_gtk/settings_sync.py:632
msgid "No existing sync archive found at this folder yet."
msgstr "Ainda não foi encontrado nenhum arquivo de sincronização existente nesta pasta."

