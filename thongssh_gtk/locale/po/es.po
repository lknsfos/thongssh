msgid "Sync file is unreadable/corrupted JSON."
msgstr "El archivo de sincronización es JSON ilegible/corrupto."

#: thongssh_gtk/settings_sync.py:245
msgid "Sync file failed its integrity check (hash mismatch) — skipping this pass."
msgstr "El archivo de sincronización no superó la comprobación de integridad (el hash no coincide) — se omite esta pasada."

#: thongssh_gtk/settings_sync.py:535
msgid "No sync folder configured."
msgstr "No hay ninguna carpeta de sincronización configurada."

#: thongssh_gtk/settings_sync.py:553
#, python-brace-format
msgid "Sync folder is missing ({folder}) even though this machine has synced before — it's most likely not mounted right now (e.g. a cloud-drive folder), not something deleted on purpose. Skipping this pass instead of treating that as \"everything was deleted\"."
msgstr "Falta la carpeta de sincronización ({folder}) aunque este equipo ya se sincronizó antes — lo más probable es que ahora mismo no esté montada (p. ej. una carpeta de un servicio en la nube), no que se haya borrado a propósito. Se omite esta pasada en lugar de tratarlo como si «se hubiera borrado todo»."

#: thongssh_gtk/settings_sync.py:564
#, python-brace-format
msgid "Can't access sync folder: {error}"
msgstr "No se puede acceder a la carpeta de sincronización: {error}"

#: thongssh_gtk/settings_sync.py:585
msgid "The sync folder has no sync file yet, but this machine has synced before — it's most likely not mounted/accessible right now. Skipping this pass instead of treating that as \"everything was deleted\"."
msgstr "La carpeta de sincronización todavía no tiene archivo de sincronización, pero este equipo ya se sincronizó antes — lo más probable es que ahora mismo no esté montada/accesible. Se omite esta pasada en lugar de tratarlo como si «se hubiera borrado todo»."

#: thongssh_gtk/settings_sync.py:602
msgid "This folder belongs to a different sync archive than the one this machine last used."
msgstr "Esta carpeta pertenece a un archivo de sincronización distinto del que esta máquina usó por última vez."

#: thongssh_gtk/settings_sync.py:632
msgid "No existing sync archive found at this folder yet."
msgstr "Aún no se ha encontrado ningún archivo de sincronización existente en esta carpeta."

